# ===========================================
# وایب‌کر – نمونه متغیرهای محیطی
# این فایل را کپی کن به .env و مقادیر را پر کن
# ===========================================

# ---- دیتابیس (الزامی) ----
# تنها منبع دیتا: سرور pgsql.feedban.ir — هیچ اتصالی به پستگرس داکر لوکال استفاده نمی‌شود.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@pgsql.feedban.ir:5174/wibe"
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@pgsql.feedban.ir:5174/wibe"

# ---- احراز هویت (الزامی) ----
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3003"

# ---- رمزنگاری (الزامی) ----
# کلید ۳۲ کاراکتری برای رمز API keys در دیتابیس
ENCRYPTION_KEY="your-32-char-encryption-key"

# ---- آدرس سایت (توصیه‌شده) ----
# برای SEO، تصاویر OG، sitemap
NEXT_PUBLIC_APP_URL="https://your-domain.com"

# ---- Capacitor (اپ اندروید) ----
# env جدا از .env اصلی — فایل‌های committed:
#   .env.capacitor.prod  → https://app.wibe.ir  (build APK)
#   .env.capacitor.dev   → http://10.0.2.2:3003 (امولاتور)
# npm run cap:sync:prod && npm run cap:build:android
# npm run cap:sync:dev  && npm run cap:run:android

# ---- Sentry (توصیه‌شده) ----
# NEXT_PUBLIC_SENTRY_DSN="https://xxx@xxx.ingest.sentry.io/xxx"
# SENTRY_ORG="your-org"
# SENTRY_PROJECT="your-project"
# SENTRY_AUTH_TOKEN="sntrys_xxx"   # فقط در CI/CD برای source map

# ---- Object Storage – ParsPack (S3-compatible) ----
# یا از پنل ادمین → تنظیمات ذخیره می‌شود
# PARSPACK_BUCKET_NAME=c466145
# PARSPACK_ENDPOINT=https://c466145.parspack.net
# PARSPACK_ACCESS_KEY=
# PARSPACK_SECRET_KEY=
# same-origin = مرورگر از /api/liara-image می‌گیرد (توصیه برای ParsPack) | direct = URL مستقیم
NEXT_PUBLIC_LIARA_IMAGE_MODE=same-origin

# ---- Umami Analytics (اختیاری) ----
# از پنل Umami → Settings → Websites → Tracking code
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# self-hosted (مثال): https://umami.dpazone.ir/script.js
# NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://umami.dpazone.ir/script.js
# اختیاری — اگر API جدا از اسکریپت باشد
# NEXT_PUBLIC_UMAMI_HOST_URL=https://umami.dpazone.ir
# محدود کردن ثبت به دامنه‌های production (جدا با کاما)
# NEXT_PUBLIC_UMAMI_DOMAINS=your-domain.com,www.your-domain.com

# ---- Rate Limiting (Upstash Redis) ----
# برای محدود کردن درخواست‌های API. بدون این متغیرها rate limiting غیرفعال است.
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=xxx

# ---- Cron ----
# CRON_SECRET=secret-for-cron-endpoints

# ---- اختیاری ----
# NEXT_PUBLIC_SKIP_EXTERNAL_IMAGES=true   # غیرفعال کردن تصاویر خارجی
# PORT=3000

# ---- Docker ----
# میرور ایمیج‌های Docker Hub (لیارا): https://liara.ir/mirrors/docker/
# DOCKER_MIRROR=docker-mirror.liara.ir
# ساخت: npm run docker:build
# اجرا:  npm run docker:up   (نیاز به .env با DATABASE_URL و NEXTAUTH_*)
# لاگ:   npm run docker:logs
# PostgreSQL لوکال: docker compose --profile local-db up -d
#   DATABASE_URL=postgresql://wibecur:wibecur_local_secret@postgres:5432/wibecur
# RUN_MIGRATIONS=true   # اجرای prisma migrate deploy هنگام استارت کانتینر
