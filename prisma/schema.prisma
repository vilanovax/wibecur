generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model bad_words {
  id        String   @id
  word      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime

  @@index([word])
}

model bookmarks {
  id        String   @id
  userId    String
  listId    String
  createdAt DateTime @default(now())
  lists     lists    @relation(fields: [listId], references: [id], onDelete: Cascade)
  users     users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, listId])
  @@index([listId])
  @@index([userId])
  @@index([listId, createdAt])
}

model categories {
  id              String            @id
  name            String
  slug            String            @unique
  icon            String
  color           String            @default("#6366F1")
  accentColor     String? // برای Category Page 2.0 - رنگ تاکید (مثلاً بنفش فیلم، نارنجی رستوران)
  description     String?
  heroImage       String? // تصویر هیرو صفحه دسته
  layoutType      String? // cinematic | locationBased | editorial | minimal
  order           Int               @default(0)
  isActive        Boolean           @default(true)
  commentsEnabled Boolean           @default(true) // فعال/غیرفعال کردن کامنت برای دسته
  trendingWeight  Float             @default(1) // ضریب وزن در الگوریتم ترندینگ (0.8 | 1.0 | 1.2 | 1.4)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime
  deletedAt       DateTime?
  deletedById     String?
  deleteReason    String?
  lists           lists[]
  suggested_lists suggested_lists[]
  sponsored_placements sponsored_placement[]
  deletedBy       users?            @relation("CategoryDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  @@index([deletedAt])
}

model comment_likes {
  id        String   @id @default(cuid())
  commentId String
  userId    String
  createdAt DateTime @default(now())
  comments  comments @relation(fields: [commentId], references: [id], onDelete: Cascade)
  users     users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@index([commentId])
  @@index([userId])
}

model comment_penalties {
  id           String   @id @default(cuid())
  commentId    String
  userId       String
  adminId      String
  penaltyScore Int      @default(0)
  action       String   @default("delete")
  createdAt    DateTime @default(now())
  comments     comments @relation(fields: [commentId], references: [id], onDelete: Cascade)
  users        users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([commentId])
  @@index([userId])
}

model comment_reports {
  id           String   @id @default(cuid())
  commentId    String
  userId       String
  reason       String?
  resolved     Boolean  @default(false)
  createdAt    DateTime @default(now())
  penaltyScore Int?     @default(0)
  comments     comments @relation(fields: [commentId], references: [id], onDelete: Cascade)
  users        users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([commentId])
  @@index([resolved])
  @@index([userId])
}

model comments {
  id                String              @id @default(cuid())
  itemId            String
  userId            String
  content           String
  isFiltered        Boolean             @default(false)
  isApproved        Boolean             @default(true)
  likeCount         Int                 @default(0)
  helpfulUp         Int                 @default(0)
  helpfulDown       Int                 @default(0)
  weightedScore     Float               @default(0)
  isSeeded          Boolean             @default(false)
  seedCampaignId    String?
  seedDraftId       String?             @unique
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  deletedAt         DateTime?
  comment_likes     comment_likes[]
  comment_votes     comment_votes[]
  comment_penalties comment_penalties[]
  comment_reports   comment_reports[]
  items             items               @relation(fields: [itemId], references: [id], onDelete: Cascade)
  users             users               @relation(fields: [userId], references: [id], onDelete: Cascade)
  seedCampaign      comment_seed_campaigns? @relation(fields: [seedCampaignId], references: [id], onDelete: SetNull)
  seedDraft         comment_seed_drafts?  @relation("PublishedSeedDraft", fields: [seedDraftId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([deletedAt])
  @@index([isApproved])
  @@index([isFiltered])
  @@index([itemId])
  @@index([userId])
  @@index([weightedScore])
  @@index([isSeeded])
  @@index([seedCampaignId])
}

model comment_votes {
  id        String   @id @default(cuid())
  userId    String
  commentId String
  value     Int
  createdAt DateTime @default(now())
  comments  comments @relation(fields: [commentId], references: [id], onDelete: Cascade)
  users     users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, commentId])
  @@index([commentId])
  @@index([userId])
}

model item_votes {
  id        String   @id
  userId    String
  itemId    String
  value     Int
  createdAt DateTime @default(now())
  items     items    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  users     users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
  @@index([itemId])
  @@index([userId])
}

model item_reports {
  id             String   @id @default(cuid())
  itemId         String
  userId         String
  reason         String // incorrect_info, offensive, spam, wrong_category, duplicate, other
  description    String? // توضیحات اضافی برای reason: other
  weightSnapshot Float? // وزن لحظه ثبت (User Trust × Report Type) برای Auto Flagging
  resolved       Boolean  @default(false)
  createdAt      DateTime @default(now())
  penaltyScore   Int?     @default(0)
  items          items    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  users          users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@index([resolved])
  @@index([userId])
}

// Vibe Moderation Engine v1 – Weighted Flag Score و وضعیت نمایش
model item_moderation {
  id          String               @id @default(cuid())
  itemId      String               @unique
  flagScore   Float                @default(0)
  status      ItemModerationStatus @default(NORMAL)
  lastUpdated DateTime             @updatedAt
  items       items                @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([flagScore])
}

/// موجودیت مشترک آیتم — یک فیلم/کتاب/کافه در چند لیست با یک شناسهٔ کاتالوگ
model catalog_items {
  id           String          @id
  title        String
  description  String?
  imageUrl     String?
  externalUrl  String?
  categorySlug String?
  metadata     Json?
  /// کلید یکتا برای ادغام (مثلاً imdb:tt123 یا title:book:نام-نرمال)
  externalKey  String?         @unique
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  items        items[]
  profile_picks profile_picks[]

  @@index([title])
  @@index([categorySlug])
}

model profile_picks {
  id            String        @id @default(cuid())
  userId        String
  catalogItemId String
  categorySlug  String
  sortOrder     Int           @default(0)
  note          String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  users         users         @relation(fields: [userId], references: [id], onDelete: Cascade)
  catalog_items catalog_items @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)

  @@unique([userId, catalogItemId])
  @@index([userId, categorySlug, sortOrder])
}

model person_profiles {
  id          String   @id @default(cuid())
  role        String
  slug        String
  displayName String
  bio         String?
  imageUrl    String?
  tmdbId      Int?
  externalUrl String?
  status      String   @default("published")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([role, slug])
  @@index([role, slug])
}

model items {
  id              String           @id
  title           String
  description     String?
  imageUrl        String?
  externalUrl     String?
  listId          String
  catalogItemId   String?
  listNote        String?
  order           Int              @default(0)
  metadata        Json?
  voteCount       Int              @default(0)
  rating          Float            @default(0)
  maxComments     Int? // حداکثر تعداد کامنت
  commentsEnabled Boolean          @default(true) // فعال/غیرفعال بودن کامنت
  createdAt       DateTime         @default(now())
  updatedAt       DateTime
  deletedAt       DateTime?
  deletedById     String?
  deleteReason    String?
  comments        comments[]
  comment_seed_drafts comment_seed_drafts[]
  item_votes      item_votes[]
  item_reports    item_reports[]
  item_moderation item_moderation?
  catalog_items   catalog_items?   @relation(fields: [catalogItemId], references: [id], onDelete: SetNull)
  lists           lists            @relation(fields: [listId], references: [id], onDelete: Cascade)
  deletedBy       users?           @relation("ItemDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  @@unique([listId, catalogItemId])
  @@index([listId])
  @@index([catalogItemId])
  @@index([deletedAt])
}

model list_likes {
  id        String   @id
  userId    String
  listId    String
  createdAt DateTime @default(now())
  lists     lists    @relation(fields: [listId], references: [id], onDelete: Cascade)
  users     users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, listId])
  @@index([listId])
  @@index([userId])
}

// Quick reactions: one per user per list (💕 عاشقش شدم | 😭 اشکم دراومد | 🌙 مناسب شب بود | 😐 معمولی بود | ➕ یه پیشنهاد دارم)
model list_reactions {
  id           String   @id @default(cuid())
  listId       String
  userId       String
  reactionType String // love | cry | night | meh | suggestion
  createdAt    DateTime @default(now())
  lists        lists    @relation(fields: [listId], references: [id], onDelete: Cascade)
  users        users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, listId])
  @@index([listId])
  @@index([userId])
}

model lists {
  id                  String               @id
  title               String
  slug                String               @unique
  description         String?
  coverImage          String?
  horizontalImage     String? // بنر افقی — featured و جزئیات لیست
  categoryId          String?
  userId              String
  tags                String[]             @default([]) // برای Similar Lists هوشمند
  badge               ListBadge?
  isPublic            Boolean              @default(true)
  isFeatured          Boolean              @default(false)
  viewCount           Int                  @default(0)
  likeCount           Int                  @default(0)
  saveCount           Int                  @default(0)
  itemCount           Int                  @default(0)
  commentsEnabled     Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  isActive            Boolean              @default(true)
  deletedAt           DateTime?
  deletedById         String?
  deleteReason        String?
  bookmarks           bookmarks[]
  items               items[]
  list_likes          list_likes[]
  list_reactions      list_reactions[]
  suggested_items     suggested_items[]
  list_comments       list_comments[]
  list_reports        list_reports[]
  categories          categories?          @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  users               users                @relation(fields: [userId], references: [id], onDelete: Cascade)
  deletedBy           users?               @relation("ListDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  home_featured_slots home_featured_slot[]
  sponsored_placements sponsored_placement[] @relation("SponsoredPlacementList")
  collaborationEnabled Boolean              @default(false)
  list_collaborators   list_collaborators[]

  @@index([categoryId])
  @@index([createdAt])
  @@index([userId])
  @@index([deletedAt])
  // کوئری داغ فید: فیلتر دستهٔ فعال/عمومی + مرتب‌سازی بر اساس saveCount
  @@index([categoryId, isActive, isPublic, saveCount(sort: Desc)])
  // واکشی «جدیدترین»های هر دسته
  @@index([categoryId, isActive, isPublic, createdAt(sort: Desc)])
}

enum ListCollaboratorRole {
  CONTRIBUTOR
  EDITOR
}

enum ListCollaborationStatus {
  PENDING
  ACCEPTED
  REJECTED
  REVOKED
}

model list_collaborators {
  id        String                  @id @default(cuid())
  listId    String
  userId    String
  role      ListCollaboratorRole    @default(CONTRIBUTOR)
  status    ListCollaborationStatus @default(PENDING)
  invitedBy String?
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt
  lists     lists                   @relation(fields: [listId], references: [id], onDelete: Cascade)
  users     users                   @relation("ListCollaboratorMember", fields: [userId], references: [id], onDelete: Cascade)
  inviter   users?                  @relation("ListCollaboratorInviter", fields: [invitedBy], references: [id], onDelete: SetNull)

  @@unique([listId, userId])
  @@index([userId, status])
  @@index([listId, status])
}

model list_reports {
  id          String   @id @default(cuid())
  listId      String
  userId      String
  reason      String
  description String?
  resolved    Boolean  @default(false)
  createdAt   DateTime @default(now())
  lists       lists    @relation(fields: [listId], references: [id], onDelete: Cascade)
  users       users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([listId])
  @@index([userId])
  @@index([resolved])
}

model settings {
  id                             String   @id @default("settings")
  openaiApiKey                   String?
  openaiModel                    String?  @default("gpt-4o-mini")
  deepseekApiKey                 String?
  deepseekModel                  String?  @default("deepseek-chat")
  tmdbApiKey                     String?
  liaraBucketName                String?
  liaraEndpoint                  String?
  liaraAccessKey                 String?
  liaraSecretKey                 String?
  updatedAt                      DateTime
  createdAt                      DateTime @default(now())
  omdbApiKey                     String?
  googleApiKey                   String?
  googleSearchEngineId           String?
  minItemsForPublicList          Int      @default(5)
  maxPersonalLists               Int      @default(3)
  personalListPublicInstructions String?
  siteLogoUrl                    String?
  maintenanceModeEnabled         Boolean  @default(false)
  maintenanceTitle               String?  @default("در حال به‌روزرسانی")
  maintenanceSubtitle            String?
  maintenanceMessage             String?
  maintenanceShowLogo            Boolean  @default(true)
  maintenanceAccentColor         String?  @default("#6366F1")
  maintenanceAllowAdminBrowse    Boolean  @default(true)
}

model user_violations {
  id                String   @id @default(cuid())
  userId            String
  commentId         String?
  violationType     String   @default("bad_word")
  violationCount    Int      @default(1)
  lastViolationDate DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime
  totalPenaltyScore Int      @default(0)
  users             users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([violationType])
}

model users {
  id                         String                     @id
  name                       String?
  email                      String                     @unique
  emailVerified              DateTime?
  image                      String?
  password                   String?
  role                       UserRole                   @default(USER)
  accountKind                AccountKind                @default(USER)
  isActive                   Boolean                    @default(true)
  /** دسترسی‌های سفارشی ادمین — اگر خالی نباشد جایگزین نقش می‌شود */
  adminPermissions           String[]                   @default([])
  reputationScore            Int                        @default(0) // +1 comment, +2 suggestion, -3 removed
  curatorScore               Int                        @default(0)
  curatorLevel               CuratorLevel               @default(EXPLORER)
  viralListsCount            Int                        @default(0)
  totalLikesReceived         Int                        @default(0)
  approvedItemsCount         Int                        @default(0)
  bio                        String?
  username                   String?                    @unique
  avatarType                 AvatarType                 @default(DEFAULT)
  avatarId                   String?
  avatarStatus               AvatarStatus? // برای آپلود شخصی
  showBadge                  Boolean                    @default(true)
  allowCommentNotifications        Boolean                    @default(true)
  allowBookmarkListNotifications Boolean                    @default(true)
  commentRestrictedUntil     DateTime?
  commentBanReason           String?
  createdAt                  DateTime                   @default(now())
  updatedAt                  DateTime
  deletedAt                  DateTime?
  deletedById                String?
  deleteReason               String?
  bookmarks                  bookmarks[]
  comment_likes              comment_likes[]
  comment_votes              comment_votes[]
  comment_penalties          comment_penalties[]
  comment_reports            comment_reports[]
  comments                   comments[]
  item_votes                 item_votes[]
  item_reports               item_reports[]
  list_likes                 list_likes[]
  list_reactions             list_reactions[]
  list_reports               list_reports[]
  lists                      lists[]
  list_collaborators         list_collaborators[]       @relation("ListCollaboratorMember")
  list_collaborators_invited list_collaborators[]       @relation("ListCollaboratorInviter")
  profile_picks              profile_picks[]
  user_violations            user_violations[]
  suggested_items            suggested_items[]
  suggested_lists            suggested_lists[]
  notifications              notifications[]
  list_comment_likes         list_comment_likes[]
  list_comment_reports       list_comment_reports[]
  list_comment_votes         list_comment_votes[]
  list_comments              list_comments[]
  followRelationsAsFollower  follows[]                  @relation("FollowsAsFollower")
  followRelationsAsFollowing follows[]                  @relation("FollowsAsFollowing")
  user_achievements          user_achievements[]
  creator_ranking            creator_rankings?
  user_category_affinity     user_category_affinity[]
  user_category_preferences  user_category_preference[]
  user_keyword_preferences   user_keyword_preference[]
  discovery_spotlight_cache  discovery_spotlight_cache?
  creator_spotlights         creator_spotlights[]
  audit_logs                 audit_log[]
  sponsored_placements_created sponsored_placement[] @relation("SponsoredPlacementCreator")
  backup_jobs_created        backup_jobs[]              @relation("BackupJobsCreated")
  book_extract_jobs_created  book_extract_jobs[]        @relation("BookExtractJobsCreated")
  comment_personas           comment_personas?
  comment_seed_campaigns     comment_seed_campaigns[]   @relation("CommentSeedCampaignCreator")
  moderation_cases_assigned  moderation_case[]
  moderation_notes           moderation_note[]
  listsDeletedBy             lists[]                    @relation("ListDeletedBy")
  categoriesDeletedBy        categories[]               @relation("CategoryDeletedBy")
  itemsDeletedBy             items[]                    @relation("ItemDeletedBy")
  usersDeletedBy             users[]                    @relation("UserDeletedBy")
  deletedBy                  users?                     @relation("UserDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  @@index([deletedAt])
  // فیلتر کریتور در کوئری‌های curated (users.role != USER)
  @@index([role])
  @@index([accountKind])
}

model creator_spotlights {
  id           String   @id @default(cuid())
  userId       String
  type         String // weekly | rising | category | editor
  categorySlug String?
  startDate    DateTime
  endDate      DateTime
  createdBy    String? // admin userId if editor pick
  users        users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([startDate, endDate])
  @@index([userId])
}

model discovery_spotlight_cache {
  id          String   @id @default(cuid())
  userId      String   @unique
  creatorId   String
  explanation String?
  updatedAt   DateTime @updatedAt
  users       users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([updatedAt])
}

model user_category_affinity {
  id           String   @id @default(cuid())
  userId       String
  categorySlug String
  weight       Float    @default(0)
  updatedAt    DateTime @updatedAt
  users        users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, categorySlug])
  @@index([userId])
}

model user_category_preference {
  id           String   @id @default(cuid())
  userId       String
  categorySlug String
  source       String   @default("inferred") // manual | inferred
  weight       Float    @default(0)
  pinned       Boolean  @default(false)
  hidden       Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  users        users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, categorySlug])
  @@index([userId])
  @@index([categorySlug])
}

model user_keyword_preference {
  id        String   @id @default(cuid())
  userId    String
  keywordId String
  source    String   @default("inferred") // manual | inferred
  weight    Float    @default(0)
  pinned    Boolean  @default(false)
  hidden    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, keywordId])
  @@index([userId])
  @@index([keywordId])
}

model creator_rankings {
  id                 String    @id @default(cuid())
  userId             String    @unique
  curatorScore       Int       @default(0)
  influenceScore     Int       @default(0)
  momentumScore      Int       @default(0)
  rankingScore       Float     @default(0)
  globalRank         Int       @default(0)
  previousGlobalRank Int? // for rank change indicator
  monthlyRank        Int? // current month rank (reset monthly)
  monthYear          String? // e.g. "2025-02"
  categoryRank       Json? // { "film": 1, "book": 3 } slug -> rank
  lastUpdated        DateTime  @updatedAt
  lastActivityAt     DateTime? // for decay: last list/bookmark/comment activity
  users              users     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([rankingScore])
  @@index([globalRank])
  @@index([momentumScore])
  @@index([monthlyRank])
}

model achievements {
  id                String              @id @default(cuid())
  code              String              @unique
  title             String
  description       String
  category          String // creation | impact | community | consistency
  tier              String              @default("bronze") // bronze | silver | gold | elite
  icon              String // emoji or icon key
  isSecret          Boolean             @default(false)
  user_achievements user_achievements[]

  @@index([category])
}

model user_achievements {
  id            String       @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime     @default(now())
  users         users        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievements  achievements @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
  @@index([achievementId])
}

model follows {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    users    @relation("FollowsAsFollower", fields: [followerId], references: [id], onDelete: Cascade)
  following   users    @relation("FollowsAsFollowing", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId])
  @@index([followerId])
}

enum ItemModerationStatus {
  NORMAL // فقط ثبت
  SOFT_FLAG // ادمین ببیند، نمایش عادی
  UNDER_REVIEW // از ترند/اسپاتلایت حذف، اولویت پایین
  HIDDEN // مخفی برای کاربران عادی، فقط ادمین و سازنده
}

enum ListBadge {
  TRENDING
  NEW
  FEATURED
}

enum UserRole {
  USER
  EDITOR
  ADMIN
  SUPER_ADMIN
  MODERATOR
  ANALYST
}

enum CuratorLevel {
  EXPLORER // 0–49
  NEW_CURATOR // 50–149
  ACTIVE_CURATOR // 150–299
  TRUSTED_CURATOR // 300–499
  INFLUENTIAL_CURATOR // 500–799
  ELITE_CURATOR // 800–1199
  VIBE_LEGEND // 1200+
}

enum AvatarType {
  DEFAULT // آواتار وایب
  UPLOADED // آپلود شخصی
}

enum AvatarStatus {
  APPROVED
  PENDING
  REJECTED
}

model audit_log {
  id         String   @id @default(cuid())
  actorId    String
  actorRole  UserRole
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  users users @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@index([action, createdAt])
}

enum ModerationStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  IGNORED
}

enum ModerationType {
  REPORT
  AUTO_FLAG
  ANOMALY
  PENDING
}

enum ModerationEntityType {
  LIST
  COMMENT
  USER
  CATEGORY
}

model moderation_case {
  id          String               @id @default(cuid())
  type        ModerationType
  entityType  ModerationEntityType
  entityId    String
  reason      String
  severity    Int                  @default(1)
  status      ModerationStatus     @default(OPEN)
  reportCount Int                  @default(0)
  metadata    Json?
  assigneeId  String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  users users?            @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  notes moderation_note[]

  @@index([status])
  @@index([type])
  @@index([entityType, entityId])
  @@index([assigneeId])
  @@index([createdAt])
  @@index([status, severity, createdAt])
  @@index([assigneeId, status])
}

model moderation_note {
  id        String   @id @default(cuid())
  caseId    String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  moderation_case moderation_case @relation(fields: [caseId], references: [id], onDelete: Cascade)
  users           users           @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([authorId])
}

model comment_settings {
  id                       String   @id @default(cuid())
  defaultMaxComments       Int? // پیش‌فرض برای آیتم‌های جدید
  defaultCommentsEnabled   Boolean  @default(true)
  maxCommentLength         Int? // حداکثر تعداد کاراکتر برای کامنت (null = بدون محدودیت)
  rateLimitMinutes         Int      @default(5) // حداقل فاصله بین کامنت‌ها برای یک آیتم (دقیقه)
  globalRateLimitMinutes   Int? // حداقل فاصله برای همه کامنت‌ها (null = غیرفعال)
  penaltyWarnThreshold     Int      @default(5)
  penaltyRestrictThreshold Int      @default(10)
  penaltyBanThreshold      Int      @default(15)
  penaltyRestrictDays      Int      @default(7)
  commentAiProvider        String   @default("openai") // openai | deepseek
  personBioAiProvider      String   @default("openai") // openai | deepseek — bio اشخاص
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

model suggested_items {
  id          String   @id @default(cuid())
  title       String
  description String?
  imageUrl    String?
  externalUrl String?
  listId      String
  userId      String
  metadata    Json?
  status      String   @default("pending") // pending, approved, rejected
  adminNotes  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  lists       lists    @relation(fields: [listId], references: [id], onDelete: Cascade)
  users       users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([listId])
  @@index([userId])
  @@index([status])
}

model suggested_lists {
  id          String     @id @default(cuid())
  title       String
  description String?
  coverImage  String?
  categoryId  String
  userId      String
  status      String     @default("pending") // pending, approved, rejected
  adminNotes  String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  categories  categories @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  users       users      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([categoryId])
  @@index([userId])
  @@index([status])
}

model notifications {
  id        String   @id @default(cuid())
  userId    String
  type      String // 'suggestion_approved', 'suggestion_rejected', 'admin_message', etc.
  title     String
  message   String
  link      String? // Optional link to related content
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  users     users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
  @@index([createdAt])
}

model list_comments {
  id                   String                 @id @default(cuid())
  listId               String
  userId               String
  parentId             String? // یک سطح پاسخ
  type                 String                 @default("comment") // comment | suggestion | opinion
  content              String
  contentHash          String? // برای تشخیص تکرار
  suggestionStatus     String? // pending | approved | rejected
  approvedItemId       String?
  status               String                 @default("active") // active | review | hidden | rejected
  isFiltered           Boolean                @default(false)
  isApproved           Boolean                @default(true)
  likeCount            Int                    @default(0)
  helpfulUp            Int                    @default(0)
  helpfulDown          Int                    @default(0)
  weightedScore        Float                  @default(0)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  deletedAt            DateTime?
  list_comment_likes   list_comment_likes[]
  list_comment_reports list_comment_reports[]
  list_comment_votes   list_comment_votes[]
  lists                lists                  @relation(fields: [listId], references: [id], onDelete: Cascade)
  users                users                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent               list_comments?         @relation("ListCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies              list_comments[]        @relation("ListCommentReplies")

  @@index([createdAt])
  @@index([deletedAt])
  @@index([isApproved])
  @@index([isFiltered])
  @@index([listId])
  @@index([userId])
  @@index([parentId])
  @@index([type])
  @@index([status])
  @@index([weightedScore])
}

model list_comment_likes {
  id            String        @id @default(cuid())
  commentId     String
  userId        String
  createdAt     DateTime      @default(now())
  list_comments list_comments @relation(fields: [commentId], references: [id], onDelete: Cascade)
  users         users         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@index([commentId])
  @@index([userId])
}

model list_comment_reports {
  id            String        @id @default(cuid())
  commentId     String
  userId        String
  reason        String?
  resolved      Boolean       @default(false)
  createdAt     DateTime      @default(now())
  penaltyScore  Int?          @default(0)
  list_comments list_comments @relation(fields: [commentId], references: [id], onDelete: Cascade)
  users         users         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([commentId])
  @@index([resolved])
  @@index([userId])
}

model list_comment_votes {
  id            String        @id @default(cuid())
  userId        String
  commentId     String
  value         Int // 1 = helpful, -1 = not helpful
  createdAt     DateTime      @default(now())
  list_comments list_comments @relation(fields: [commentId], references: [id], onDelete: Cascade)
  users         users         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, commentId])
  @@index([commentId])
  @@index([userId])
}

// --- هوم موبایل: منتخب هفته با زمان‌بندی ---
enum HomeFeaturedAction {
  VIEW_LIST
  QUICK_SAVE
}

model home_featured_slot {
  id         String                @id @default(cuid())
  listId     String
  startAt    DateTime
  endAt      DateTime? // null = تا شروع اسلات بعدی یا نامحدود
  orderIndex Int                   @default(0)
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt
  lists      lists                 @relation(fields: [listId], references: [id], onDelete: Cascade)
  events     home_featured_event[]

  // Featured Performance Analytics (MVP)
  impressions   Int    @default(0)
  clicks        Int    @default(0)
  baselineSaves Int?
  savesDuring   Int    @default(0)
  baselineScore Float?
  peakScore     Float?

  @@index([startAt])
  @@index([listId])
}

model home_featured_event {
  id        String             @id @default(cuid())
  slotId    String
  listId    String // برای کوئری راحت
  action    HomeFeaturedAction
  userId    String? // null برای مهمان
  createdAt DateTime           @default(now())
  slot      home_featured_slot @relation(fields: [slotId], references: [id], onDelete: Cascade)

  @@index([slotId])
  @@index([listId])
  @@index([createdAt])
}

// جلوگیری از اسپم: یک بار به ازای هر اسلات منقضی‌شده نوتیف می‌سازیم
model admin_featured_notification_sent {
  id        String   @id @default(cuid())
  slotId    String   @unique
  createdAt DateTime @default(now())

  @@index([slotId])
}

// --- تبلیغات متنی اسپانسری (دسته / لیست) ---
model sponsored_placement {
  id              String   @id @default(cuid())
  name            String?
  scopeType       String // CATEGORY_ALL | CATEGORY_SELECTED | LIST
  categoryId      String?
  listIds         String[] @default([])
  listId          String?
  surface         String // LIST_BANNER | LIST_SIDEBAR | LIST_AFTER_SIMILAR | CATEGORY_BANNER
  headline        String
  bodyText        String?
  ctaLabel        String
  destinationUrl  String
  sponsorName     String?
  disclosureLabel String   @default("تبلیغ")
  startAt         DateTime
  endAt           DateTime?
  isActive        Boolean  @default(true)
  priority        Int      @default(0)
  impressions     Int      @default(0)
  clicks          Int      @default(0)
  createdById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  categories      categories? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  lists           lists?      @relation("SponsoredPlacementList", fields: [listId], references: [id], onDelete: SetNull)
  createdBy       users?      @relation("SponsoredPlacementCreator", fields: [createdById], references: [id], onDelete: SetNull)
  events          sponsored_placement_event[]

  @@index([categoryId])
  @@index([listId])
  @@index([surface, isActive, startAt])
}

model sponsored_placement_event {
  id          String   @id @default(cuid())
  placementId String
  action      String // IMPRESSION | CLICK
  userId      String?
  listId      String?
  categoryId  String?
  createdAt   DateTime @default(now())
  placement   sponsored_placement @relation(fields: [placementId], references: [id], onDelete: Cascade)

  @@index([placementId])
  @@index([createdAt])
}

/// آمار تجمیعی جستجو — برای «پرجستجو» در overlay
model search_query_stats {
  id              String   @id @default(cuid())
  normalizedQuery String   @unique @map("normalized_query")
  displayQuery    String   @map("display_query")
  searchCount     Int      @default(1) @map("search_count")
  lastSearchedAt  DateTime @default(now()) @map("last_searched_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([searchCount(sort: Desc)])
  @@index([lastSearchedAt(sort: Desc)])
  @@map("search_query_stats")
}

enum BackupJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum BookExtractJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum BookExtractSource {
  taaghche
  fidibo
  ketabrah
}

enum BookExtractMode {
  titles
  category
}

enum AccountKind {
  USER
  PERSONA
  BOT
}

enum CommentSeedTargetType {
  item
  list
  category
}

enum CommentSeedCampaignStatus {
  draft
  generating
  ready
  publishing
  published
  paused
  archived
}

enum CommentSeedDraftStatus {
  draft
  approved
  rejected
  published
}

enum CommentSeedTone {
  positive
  negative
  neutral
  question
}

enum CommentSeedScopeType {
  category
  list
  item
}

model comment_personas {
  id          String   @id @default(cuid())
  displayName String
  username    String   @unique
  avatarUrl   String?
  userId      String   @unique
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users              users                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment_seed_drafts comment_seed_drafts[]

  @@index([isActive])
}

model comment_seed_campaigns {
  id              String                    @id @default(cuid())
  title           String
  status          CommentSeedCampaignStatus @default(draft)
  targetType      CommentSeedTargetType
  targetIds       String[]                  @default([])
  commentCount    Int                       @default(10)
  perItemCount    Int?
  toneMix         Json
  wordCountMin    Int                       @default(40)
  wordCountMax    Int                       @default(120)
  dateFrom        DateTime
  dateTo          DateTime
  openaiModel     String?
  createdByAdminId String
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  createdByAdmin users                 @relation("CommentSeedCampaignCreator", fields: [createdByAdminId], references: [id], onDelete: Cascade)
  drafts         comment_seed_drafts[]
  comments       comments[]
  rules          comment_seed_rules[]

  @@index([status])
  @@index([createdByAdminId])
  @@index([createdAt])
}

model comment_seed_drafts {
  id                 String                 @id @default(cuid())
  campaignId         String
  itemId             String
  personaId          String
  content            String
  tone               CommentSeedTone
  wordCount          Int                    @default(0)
  scheduledAt        DateTime
  status             CommentSeedDraftStatus @default(draft)
  publishedCommentId String?                @unique
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  campaign         comment_seed_campaigns @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  items            items                  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  persona          comment_personas       @relation(fields: [personaId], references: [id], onDelete: Restrict)
  publishedComment comments?              @relation("PublishedSeedDraft")

  @@index([campaignId])
  @@index([itemId])
  @@index([status])
  @@index([scheduledAt])
}

model comment_seed_rules {
  id         String               @id @default(cuid())
  scopeType  CommentSeedScopeType
  scopeId    String
  enabled    Boolean              @default(true)
  campaignId String?
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  campaign comment_seed_campaigns? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@unique([scopeType, scopeId])
  @@index([enabled])
  @@index([campaignId])
}

model book_extract_jobs {
  id            String                @id @default(cuid())
  createdById   String
  status        BookExtractJobStatus  @default(PENDING)
  mode          BookExtractMode       @default(titles)
  source        BookExtractSource
  input         Json
  options       Json                  @default("{}")
  targetListId  String?
  progress      Int                   @default(0)
  progressMeta  Json?
  resultItems   Json?
  itemCount     Int                   @default(0)
  errorMessage  String?
  createdAt     DateTime              @default(now())
  completedAt   DateTime?

  createdBy users @relation("BookExtractJobsCreated", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([createdById, createdAt])
  @@index([status, createdAt])
}

model backup_jobs {
  id            String          @id @default(cuid())
  createdById   String
  status        BackupJobStatus @default(PENDING)
  scopes        Json
  assetMode     String          @default("none")
  includeTrash  Boolean         @default(false)
  fileName      String?
  filePath      String?
  fileSizeBytes BigInt?
  manifest      Json?
  stats         Json?
  errorMessage  String?
  progress      Int             @default(0)
  createdAt     DateTime        @default(now())
  completedAt   DateTime?

  createdBy users @relation("BackupJobsCreated", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([createdById, createdAt])
  @@index([status, createdAt])
}
