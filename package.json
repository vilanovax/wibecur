{
  "name": "wibecur",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lighthouse:ci": "lhci autorun",
    "lighthouse:prod": "LHCI_BASE_URL=${LHCI_BASE_URL:-http://localhost:3003} LHCI_CATEGORY_PATH=/categories/film lhci autorun",
    "dev": "node scripts/dev.mjs",
    "dev:webpack": "node scripts/dev.mjs --webpack",
    "dev:next": "next dev",
    "build": "next build",
    "build:webpack": "cross-env NODE_OPTIONS=--max-old-space-size=4096 next build --webpack",
    "postbuild": "node scripts/prepare-standalone.mjs",
    "prestart": "node scripts/prepare-standalone.mjs",
    "prebuild": "node scripts/bump-admin-panel-version.mjs && prisma generate",
    "start": "NODE_OPTIONS='--max-http-header-size=16384' node .next/standalone/server.js",
    "lint": "next lint",
    "export:missing-bios": "tsx scripts/export-missing-person-bios.ts",
    "db:push": "prisma db push",
    "db:catalog:backfill": "npx tsx scripts/backfill-catalog-items.ts",
    "db:migrate": "prisma migrate dev",
    "db:seed": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' prisma/seed.ts",
    "db:export": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' scripts/export-database.ts",
    "db:studio": "prisma studio",
    "db:docker:up": "docker-compose up -d",
    "db:docker:init": "prisma generate && prisma db push && npm run db:seed",
    "docker:build": "docker compose build app",
    "docker:up": "docker compose up -d app",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f app",
    "migrate:images": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' scripts/migrate-all-images-to-liara.ts",
    "migrate:images:dry-run": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' scripts/migrate-all-images-to-liara.ts --dry-run",
    "migrate:images:batch": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' scripts/migrate-all-images-to-liara.ts --batch=10",
    "replace:unsplash": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' scripts/replace-unsplash-with-picsum-and-upload.ts",
    "replace:unsplash:all": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' scripts/replace-unsplash-with-picsum-and-upload.ts --all",
    "replace:unsplash:dry-run": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' scripts/replace-unsplash-with-picsum-and-upload.ts --dry-run",
    "set-liara-config": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' scripts/set-liara-config.ts",
    "download:banners": "node scripts/download-category-banners.mjs",
    "set-cafe-hero": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' scripts/set-cafe-category-hero.ts",
    "enrich:posters": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' scripts/enrich-seed-posters.ts",
    "enrich:posters:dry-run": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' scripts/enrich-seed-posters.ts --dry-run",
    "enrich:posters:seed": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' scripts/enrich-seed-posters.ts --update-seed-json",
    "enrich:search": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' scripts/enrich-catalog-search.ts",
    "enrich:search:dry-run": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' scripts/enrich-catalog-search.ts --dry-run --only-missing",
    "seed:item-images": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' scripts/assign-item-placeholder-images.ts",
    "seed:item-images:dry-run": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' scripts/assign-item-placeholder-images.ts --dry-run",
    "fix:tmdb-images": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' scripts/replace-tmdb-item-images.ts",
    "fix:tmdb-images:dry-run": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' scripts/replace-tmdb-item-images.ts --dry-run",
    "cap:sync": "cross-env CAPACITOR_ENV=prod node scripts/prepare-capacitor-shell.mjs && cross-env CAPACITOR_ENV=prod npx cap sync android",
    "cap:sync:prod": "cross-env CAPACITOR_ENV=prod node scripts/prepare-capacitor-shell.mjs && cross-env CAPACITOR_ENV=prod npx cap sync android",
    "cap:sync:dev": "cross-env CAPACITOR_ENV=dev node scripts/prepare-capacitor-shell.mjs && cross-env CAPACITOR_ENV=dev npx cap sync android",
    "cap:open:android": "npm run cap:sync:prod && npx cap open android",
    "cap:run:android": "npm run cap:sync:dev && cross-env CAPACITOR_ENV=dev ANDROID_HOME=$HOME/Library/Android/sdk npx cap run android",
    "cap:run:android:prod": "npm run cap:sync:prod && cross-env CAPACITOR_ENV=prod ANDROID_HOME=$HOME/Library/Android/sdk npx cap run android",
    "cap:install:android": "npm run cap:sync:prod && cd android && ./gradlew installDebug && $HOME/Library/Android/sdk/platform-tools/adb shell am start -n ir.wibecur.app/.MainActivity",
    "cap:build:android": "npm run cap:sync:prod && cd android && ./gradlew assembleDebug",
    "cap:build:android:release": "npm run cap:sync:prod && cd android && ./gradlew assembleRelease"
  },
  "prisma": {
    "seed": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.1",
    "@aws-sdk/client-s3": "^3.946.0",
    "@aws-sdk/lib-storage": "^3.946.0",
    "@capacitor/android": "^8.4.1",
    "@capacitor/app": "^8.1.0",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@fontsource/vazirmatn": "^5.2.8",
    "@hookform/resolvers": "^3.10.0",
    "@prisma/client": "^6.19.3",
    "@sentry/nextjs": "^10.59.0",
    "@tanstack/react-query": "^5.101.0",
    "@vercel/analytics": "^1.6.1",
    "archiver": "^7.0.1",
    "axios": "^1.13.2",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.0",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "framer-motion": "^11.18.2",
    "lucide-react": "^0.556.0",
    "nanoid": "^5.1.6",
    "next": "^16.2.9",
    "next-auth": "^5.0.0-beta.31",
    "openai": "^6.10.0",
    "pg": "^8.16.3",
    "prisma": "^6.19.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.68.0",
    "react-is": "^19.2.7",
    "react-multi-date-picker": "^4.5.2",
    "recharts": "^3.5.1",
    "sharp": "^0.35.2",
    "tailwind-merge": "^2.6.0",
    "unzipper": "^0.12.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@lhci/cli": "^0.14.0",
    "@playwright/test": "^1.58.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/archiver": "^6.0.4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/unzipper": "^0.10.11",
    "@vitejs/plugin-react": "^5.1.4",
    "autoprefixer": "^10.4.17",
    "baseline-browser-mapping": "^2.9.19",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.2.9",
    "jsdom": "^28.0.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.19",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.0.18",
    "wait-on": "^8.0.5"
  },
  "overrides": {
    "baseline-browser-mapping": "^2.9.19"
  }
}
